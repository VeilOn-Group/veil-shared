# Build tags for the sing-box core, per component.
#
# client: the official release build is used as-is (verified tag set includes
#   with_naive_outbound, with_clash_api, with_quic, with_utls, with_gvisor).
CLIENT_USES_OFFICIAL_RELEASE=true

# node: a custom build is REQUIRED, because the official release does not include
#   with_v2ray_api (verified: `v2ray api is not included in this build`), which
#   per-user traffic accounting needs. REALITY server and naive inbound
#   work in the official build without extra tags (verified with `sing-box check`).
NODE_TAGS=with_quic,with_utls,with_acme,with_v2ray_api,with_gvisor
# 1.13.x requires extra linker flags; take them from upstream release config.
# Flags: https://sing-box.sagernet.org/installation/build-from-source/
NODE_LDFLAGS=-s -w -buildid= -checklinkname=0
