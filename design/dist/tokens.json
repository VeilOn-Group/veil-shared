{
  "$schema_version": "1.0.0",
  "theme": "dark",
  "color": {
    "bg-base": "#0A0A0F",
    "bg-surface": "#12121A",
    "bg-elevated": "#1A1A26",
    "border": "#2A2A3A",
    "border-strong": "#6A6A88",
    "primary": "#8B5CF6",
    "primary-solid": "#7C3AED",
    "primary-hover": "#6D28D9",
    "primary-deep": "#6D28D9",
    "accent": "#A78BFA",
    "text-primary": "#F4F4F8",
    "text-muted": "#9A9AB0",
    "success": "#22C55E",
    "warning": "#F59E0B",
    "danger": "#EF4444",
    "focus-ring": "#A78BFA"
  },
  "effect": {
    "glow": "rgba(139,92,246,0.35)"
  },
  "font": {
    "ui": "Inter, ui-sans-serif, system-ui, sans-serif",
    "mono": "'JetBrains Mono', ui-monospace, monospace"
  },
  "radius": { "sm": "6px", "md": "10px", "lg": "16px", "full": "9999px" },
  "contrast": {
    "text": [
      ["text-primary", "bg-base"],
      ["text-primary", "bg-surface"],
      ["text-primary", "bg-elevated"],
      ["text-muted", "bg-base"],
      ["text-muted", "bg-surface"],
      ["text-muted", "bg-elevated"],
      ["accent", "bg-base"],
      ["accent", "bg-surface"],
      ["text-primary", "primary-solid"],
      ["text-primary", "primary-hover"],
      ["danger", "bg-base"],
      ["danger", "bg-surface"],
      ["success", "bg-base"],
      ["warning", "bg-base"]
    ],
    "ui": [
      ["border-strong", "bg-base"],
      ["border-strong", "bg-surface"],
      ["border-strong", "bg-elevated"],
      ["focus-ring", "bg-base"],
      ["focus-ring", "bg-elevated"],
      ["primary", "bg-base"]
    ]
  }
}
