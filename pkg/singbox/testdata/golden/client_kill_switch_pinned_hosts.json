{
  "log": {
    "level": "warn"
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "dns-remote",
        "server": "1.1.1.1",
        "detour": "sel-tcp"
      },
      {
        "type": "local",
        "tag": "dns-local",
        "routing_mark": 22089
      },
      {
        "type": "hosts",
        "tag": "dns-pinned",
        "predefined": {
          "node1.example.net": [
            "203.0.113.10"
          ]
        }
      }
    ],
    "final": "dns-remote",
    "strategy": "prefer_ipv4"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "veilon0",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "mtu": 1400,
      "auto_route": true,
      "strict_route": true,
      "stack": "mixed"
    },
    {
      "type": "mixed",
      "tag": "probe-in",
      "listen": "127.0.0.1",
      "listen_port": 19077,
      "users": [
        {
          "username": "xhttp",
          "password": "golden-probe-password"
        },
        {
          "username": "vless",
          "password": "golden-probe-password"
        },
        {
          "username": "hy2",
          "password": "golden-probe-password"
        },
        {
          "username": "naive",
          "password": "golden-probe-password"
        },
        {
          "username": "direct",
          "password": "golden-probe-password"
        }
      ]
    }
  ],
  "outbounds": [
    {
      "type": "socks",
      "tag": "xhttp",
      "server": "127.0.0.1",
      "server_port": 1091,
      "password": "x-golden-pass-not-real",
      "username": "x-golden",
      "version": "5"
    },
    {
      "type": "socks",
      "tag": "vless",
      "server": "127.0.0.1",
      "server_port": 1092,
      "password": "v-golden-pass-not-real",
      "username": "v-golden",
      "version": "5"
    },
    {
      "type": "hysteria2",
      "tag": "hy2",
      "server": "203.0.113.10",
      "server_port": 443,
      "server_ports": [
        "20000:40000"
      ],
      "hop_interval": "30s",
      "up_mbps": 50,
      "down_mbps": 200,
      "obfs": {
        "type": "salamander",
        "password": "fixture-obfs"
      },
      "password": "fixture-hy2-password",
      "tls": {
        "enabled": true,
        "server_name": "node1.example.net",
        "alpn": [
          "h3"
        ]
      }
    },
    {
      "type": "naive",
      "tag": "naive",
      "server": "node1.example.net",
      "server_port": 443,
      "password": "fixture-naive-password",
      "username": "u_fixture",
      "quic": false,
      "tls": {
        "enabled": true,
        "server_name": "node1.example.net"
      }
    },
    {
      "type": "selector",
      "tag": "sel-tcp",
      "outbounds": [
        "xhttp",
        "vless",
        "naive",
        "hy2"
      ],
      "default": "xhttp",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "sel-udp",
      "outbounds": [
        "xhttp",
        "vless",
        "hy2"
      ],
      "default": "xhttp",
      "interrupt_exist_connections": true
    },
    {
      "type": "direct",
      "tag": "direct",
      "routing_mark": 22089
    }
  ],
  "route": {
    "rules": [
      {
        "process_path": [
          "/usr/lib/veilon/xray"
        ],
        "outbound": "direct"
      },
      {
        "inbound": [
          "probe-in"
        ],
        "auth_user": [
          "xhttp"
        ],
        "outbound": "xhttp"
      },
      {
        "inbound": [
          "probe-in"
        ],
        "auth_user": [
          "vless"
        ],
        "outbound": "vless"
      },
      {
        "inbound": [
          "probe-in"
        ],
        "auth_user": [
          "hy2"
        ],
        "outbound": "hy2"
      },
      {
        "inbound": [
          "probe-in"
        ],
        "auth_user": [
          "naive"
        ],
        "outbound": "naive"
      },
      {
        "inbound": [
          "probe-in"
        ],
        "auth_user": [
          "direct"
        ],
        "outbound": "direct"
      },
      {
        "inbound": [
          "probe-in"
        ],
        "action": "reject"
      },
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "domain_suffix": [
          "bank.example.rs"
        ],
        "outbound": "direct"
      },
      {
        "package_name": [
          "org.example.bank"
        ],
        "outbound": "direct"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "network": "udp",
        "outbound": "sel-udp"
      }
    ],
    "final": "sel-tcp",
    "auto_detect_interface": true,
    "default_domain_resolver": "dns-pinned"
  },
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:19090",
      "secret": "golden-secret-not-real"
    },
    "cache_file": {
      "enabled": true,
      "path": "/run/veilon/cache.db",
      "store_fakeip": false,
      "store_rdrc": false
    }
  }
}
